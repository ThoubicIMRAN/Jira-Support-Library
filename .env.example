# Copy this file to .env and fill in real values.
# NEVER commit a real .env file.

# ── Database ────────────────────────────────────────────────
# Local development (SQLite – no Docker needed):
DATABASE_URL=sqlite:///./data/jira_support_library.db

# Docker / production (PostgreSQL):
# DATABASE_URL=postgresql+psycopg://jira_user:CHANGE_ME_STRONG_PASSWORD@db:5432/jira_support
# POSTGRES_DB=jira_support
# POSTGRES_USER=jira_user
# POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# ── App secrets (REQUIRED in production) ────────────────────
APP_SECRET_KEY=CHANGE_ME_TO_A_LONG_RANDOM_STRING
FERNET_KEY=   # generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"

# ── Session / security ──────────────────────────────────────
SESSION_TIMEOUT_MINUTES=90
SESSION_ABSOLUTE_HOURS=12
LOGIN_MAX_FAILURES=5
LOGIN_LOCK_MINUTES=240
RESET_TOKEN_MINUTES=60
INVITATION_TOKEN_HOURS=24

# ── OAuth (optional) ────────────────────────────────────────
OAUTH_AUTO_CREATE=false
OAUTH_ALLOWED_DOMAINS=
MS_CLIENT_ID=
MS_CLIENT_SECRET=
MS_TENANT_ID=organizations
MS_REDIRECT_URI=
MS_ALLOWED_TENANT_IDS=
MS_APP_ROLE_MAP={}
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

# ── Health endpoint ─────────────────────────────────────────
HEALTH_TOKEN=   # set a long random token; leave empty to disable

# ── App URL / reverse proxy ─────────────────────────────────
APP_URL=http://localhost:8501
APP_ROOT_PATH=

# ── Backups ─────────────────────────────────────────────────
BACKUP_DIR=./backups
BACKUP_RETENTION_DAYS=30

# ── Jira integration (per-user tokens are stored Fernet-encrypted) ──
JIRA_ENABLED=true
JIRA_PRODUCT=cloud            # cloud | server
JIRA_BASE_URL=                # https://your-domain.atlassian.net  (HTTPS required in production)
JIRA_REQUEST_TIMEOUT=30
CONFLUENCE_BASE_URL=          # e.g. https://confluence.example.com  (required for Confluence; pasted links must match this host)
BULK_MAX_TICKETS=25           # max tickets per bulk comment
BULK_DELAY_SECONDS=0.3        # pause between bulk posts (Jira rate limits)
JIRA_MAX_ATTACHMENT_MB=10

# First admin account (created on first start; you must change the password at first sign-in)
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=   # required in production; in development a random one is printed once if empty
